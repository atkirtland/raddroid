# Generated by RadDroid on first run. This file is only written once —
# feel free to hand-edit it afterward (with any file manager / text editor
# app pointed at this folder); RadDroid will not overwrite your changes.
# Full option reference: https://radicale.org/master.html#documentation/configuration

[server]
hosts = 127.0.0.1:5232
# RadDroid binds to localhost only, so the server is reachable from apps on
# this device but not from other devices on your network. To allow LAN
# access instead, change the line above to: hosts = 0.0.0.0:5232

[auth]
# No login is required by default, since the server isn't exposed to the
# network. To require one, switch to htpasswd auth:
#   type = htpasswd
#   htpasswd_filename = __BASE_DIR__/users
#   htpasswd_encryption = autodetect
# then create __BASE_DIR__/users with "username:password" lines (plain) or
# use the `htpasswd` command-line tool to add hashed entries.
type = none

[rights]
type = owner_only

[storage]
# Android's shared storage (/storage/emulated/0/...) is backed by a FUSE
# filesystem that doesn't support flock(), which the default "multifilesystem"
# backend needs for cross-process locking. RadDroid only ever runs one
# Radicale process, so the lock-free backend is safe here and avoids
# "Function not implemented" errors on every write.
type = multifilesystem_nolock
filesystem_folder = __BASE_DIR__/collections

[web]
type = internal

[logging]
level = info
